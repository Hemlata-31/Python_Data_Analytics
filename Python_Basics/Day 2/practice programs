# Program to input 2 number and perform arithmatic operations

print("\n", "PROGRAM 1")
input1 = int(input("Enter first number: "))
input2 = int(input("Enter second number: "))

print("Addition of two number is:", input1 + input2)
print("Subtraction of two number is:", input1 - input2)
print("Multiplication of two number is:", input1 * input2)
print("Division of two number is:", input1 / input2)

