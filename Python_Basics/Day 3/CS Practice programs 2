# Program to find the grade of a student based on marks

marks = int(input("Enter your marks:-"))

if(marks >= 90):
    print("Grade A")
elif(marks < 90 and marks >= 80):
    print("Grade B")
elif(marks < 80 and marks >= 70):
    print("Grade C")      
else:
    print("Grade D")

print("Congratulations!")   

