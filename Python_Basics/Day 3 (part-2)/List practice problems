# WAP to check if a list contains a palindrome of elements.
# Used copy method copy()
print("PROGRAM 2")

list = [1, 3, 'abcba', 3, 1]
copy_list = list.copy()
copy_list.reverse()
if(copy_list == list):
    print("Palindrome")
else:
    print("Not an Palindrome")

